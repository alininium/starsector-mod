{
    "id": "default",
    "name": "Balanced",
    "description": "Every tactic at moderate settings. Used when no other doctrine fits; the others extend it.",
    "formatVersion": 1,
    "select": { "when": true, "weight": 0 },
    "commander": {
        "thinkInterval": 2.0,
        "reactionTime": 1.0,
        "scoreNoise": 0.1,
        "useCommandPoints": true,
        "cpReserve": 1,
        "announce": true
    },
    "phases": [
        { "id": "opening", "when": { "fact": "battle.time", "<": 40 } },
        { "id": "winning", "when": { "fact": "battle.strengthRatio", ">=": 1.8 } },
        { "id": "losing",  "when": { "fact": "battle.strengthRatio", "<=": 0.6 } },
        { "id": "main" }
    ],
    "tactics": [
        {
            "id": "save_wrecks",
            "type": "retreat_damaged",
            "priority": 100,
            "cpPriority": "high",
            "ships": { "require": { "any": [ { "fact": "hull", "<": 0.3 }, { "fact": "cr", "<": 0.2 } ] } },
            "keepLast": 1,
            "keepFlagship": true
        },
        {
            "id": "pounce",
            "type": "pounce",
            "priority": 90,
            "maxTasks": 1,
            "window": 6,
            "targets": {
                "require": { "all": [
                    { "any": [ { "fact": "overloaded", "==": 1 }, { "fact": "venting", "==": 1 } ] },
                    { "fact": "nearestDistance", "<=": 0.15 }
                ] },
                "score": { "value": 1, "damageMatch": 1, "nearestDistance": -6 }
            },
            "ships": {
                "require": { "all": [ { "fact": "flux", "<": 0.6 }, { "fact": "nearestDistance", "<=": 0.2 } ] },
                "pick": "nearest",
                "max": 3
            },
            "order": "eliminate"
        },
        {
            "id": "hunt_loners",
            "type": "hunt_isolated",
            "priority": 80,
            "phases": ["main", "winning"],
            "maxTasks": 1,
            "targets": {
                "require": { "all": [ { "fact": "isolation", ">=": 0.6 }, { "fact": "phased", "==": 0 } ] },
                "score": { "value": 1, "isolation": 3, "hullMissing": 1, "playerFlagship": 2, "nearestDistance": -3 },
                "minScore": 2
            },
            "ships": {
                "roles": ["hunter", "skirmisher", "phase"],
                "pick": "nearest",
                "strength": 2.0,
                "min": 2,
                "max": 4,
                "require": { "all": [ { "fact": "hull", ">": 0.5 }, { "fact": "flux", "<": 0.7 } ] }
            },
            "order": "eliminate",
            "keep": {
                "minTime": 8,
                "timeout": 45,
                "switchMargin": 1.3,
                "onEnd": "rejoin",
                "abort": { "any": [
                    { "fact": "target.isolation", "<": 0.35 },
                    { "fact": "pack.hullLost", ">": 0.35 },
                    { "fact": "pack.leash", ">": 4000 }
                ] }
            },
            "announce": "hunting the isolated {target}"
        },
        {
            "id": "focus",
            "type": "focus_fire",
            "priority": 60,
            "maxTasks": 2,
            "targets": {
                "require": { "fact": "phased", "==": 0 },
                "score": { "value": 1, "flux": 2, "hardFlux": 1, "hullMissing": 2, "damageMatch": 1,
                           "playerFlagship": 0.5, "nearestDistance": -3 }
            },
            "ships": { "roles": ["line", "anchor", "hunter"], "strength": 1.5, "max": 4 },
            "order": "engage",
            "keep": { "minTime": 10, "switchMargin": 1.3 }
        },
        {
            "id": "screens",
            "type": "escort",
            "priority": 50,
            "escortees": { "all": [
                { "any": [ { "fact": "carrier", "==": 1 }, { "fact": "flagship", "==": 1 } ] },
                { "fact": "size.frigate", "==": 0 }
            ] },
            "ships": { "roles": ["skirmisher", "hunter"], "pick": "nearest", "max": 1 },
            "order": "escort_light"
        },
        {
            "id": "points",
            "type": "objectives",
            "priority": 40,
            "phases": ["opening", "main", "winning"],
            "ships": { "roles": ["skirmisher"], "max": 1 },
            "assaultWhen": { "fact": "battle.strengthRatio", ">=": 1.3 },
            "targets": { "score": { "distance": -3 } }
        },
        {
            "id": "mop_up",
            "type": "fleet_stance",
            "priority": 10,
            "when": { "all": [ { "fact": "battle.totalRatio", ">=": 4 }, { "fact": "battle.time", ">": 90 } ] },
            "order": "full_assault"
        },
        {
            "id": "give_up",
            "type": "fleet_stance",
            "priority": 5,
            "when": { "all": [ { "fact": "battle.totalRatio", "<=": 0.2 }, { "fact": "own.lossFraction", ">=": 0.6 },
                               { "fact": "battle.time", ">": 60 } ] },
            "order": "full_retreat"
        }
    ]
}
