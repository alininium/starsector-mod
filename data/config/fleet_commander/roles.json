        { "id": "line",       "require": { "fact": "size.cruiser", "==": 1 } },
        { "id": "hunter",     "require": { "all": [ { "fact": "size.destroyer", "==": 1 },
                                                    { "fact": "speed", ">=": 100 } ] } },
        { "id": "line",       "require": { "fact": "size.destroyer", "==": 1 } },
        { "id": "skirmisher", "require": true }
    ]
